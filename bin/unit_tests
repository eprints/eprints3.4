#!/usr/bin/perl -w

use FindBin;
use lib "$FindBin::Bin/../perl_lib";

######################################################################
#
#
######################################################################

=pod

=for Pod2Wiki

=head1 NAME

B<unit_tests> - Unit testing for EPrints

=head1 SYNOPSIS

B<unit_tests> [I<repository_id>] [B<options>] [I<test_file> ...]

=head1 DESCRIPTION

Runs unit tests under F<tests/> against a chosen EPrints repository.

=head1 ARGUMENTS

=over 8

=item B<repository_id> 

The ID of the EPrints repository to run unit tests against.

=back

=head1 OPTIONS

=over 8

=item B<--help>

Print a brief help message and exit.

=item B<--force>

Ignore warnings and run anyway.

=item B<--man>

Print the full manual page and then exit.

=item B<--quiet>

This option will suppress all output unless an error occurs.

=item B<--verbose>

Explain in detail what is going on.

=item B<--version>

Output version information and exit.

=back   

=cut

use EPrints;

use Sys::Hostname;
use DBI;
use Data::Dumper;
use File::Path;

use strict;
use Getopt::Long;
use Pod::Usage;

my $verbose = 0;
my $quiet = 0;
my $help = 0;
my $man = 0;
my $version = 0;
my $force = 0;

my( @todo ) = @ARGV;

my %todo = map { $_ => 1 } @todo;

eval "use Test::Harness";
if( $@ )
{
    die "Can't do unit tests without Test::Harness: $@";
}

my $base_path = $EPrints::SystemSettings::conf->{base_path};
my $test_path = "$base_path/tests";

opendir( DIR, $test_path ) or die "Unable to open unit test path $test_path: $!";
my @test_files = grep { -f "$test_path/$_" && $_ !~ /^\./ && $_ =~ /\.pl$/ } readdir( DIR );
closedir( DIR );

@test_files = sort { $a cmp $b } @test_files;

# The documented repository_id argument: a first argument that is not a test
# file is the repository to test against, handed to EPrints::Test (see
# get_test_id) through the environment of the test scripts.
my %is_test = map { $_ => 1, substr($_,0,-3) => 1 } @test_files;
if( @todo && !$is_test{$todo[0]} )
{
	$ENV{EPRINTS_TEST_REPOSITORY} = shift @todo;
	%todo = map { $_ => 1 } @todo;
}

if( scalar(@todo) )
{
    @test_files = grep { $todo{$_} or $todo{substr($_,0,-3)} } @test_files;
}

exit(0) if runtests(map { "$test_path/$_" } @test_files);

######################################################################
=pod

